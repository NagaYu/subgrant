{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subgrant.dev/schema/dgraph-1.json",
  "title": "dgraph/1 delegation graph document",
  "description": "A delegation graph. Structural constraints expressible in JSON Schema are enforced here; cross-edge constraints (exactly one root, no dangling parent_edge, no duplicate ids, no cycles) are enforced by subgrant.graph.load_graph and reported as input errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": {"const": "dgraph/1"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/edge"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "trust_tier"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "agent", "service"]},
        "trust_tier": {"enum": ["T0", "T1", "T2", "T3"]}
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "resource_pattern": {
      "type": "string",
      "description": "'*', a literal with no '*', or a literal prefix ending in '/*'.",
      "pattern": "^(\\*|[^*]*|[^*]+/\\*)$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "actions", "resources", "data_classes"],
      "properties": {
        "tools": {"type": "array", "items": {"type": "string"}},
        "actions": {"type": "array", "items": {"type": "string"}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/resource_pattern"}},
        "data_classes": {
          "type": "array",
          "items": {"enum": ["public", "internal", "confidential", "restricted"]}
        }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "limit"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "limit": {"type": "number"}
      }
    },
    "caveats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issued_at", "redelegation", "purposes"],
      "properties": {
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {
          "oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]
        },
        "redelegation": {"type": "boolean"},
        "depth_budget": {"type": "integer", "minimum": 1},
        "caps": {"type": "array", "items": {"$ref": "#/$defs/cap"}},
        "purposes": {
          "type": "array",
          "items": {
            "enum": ["read", "write", "communicate", "execute", "transact", "administer", "delegate"]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["signature", "attestation", "none"]},
        "ref": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent_edge", "issuer", "holder", "authority", "caveats", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parent_edge": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "issuer": {"type": "string", "minLength": 1},
        "holder": {"type": "string", "minLength": 1},
        "authority": {"$ref": "#/$defs/authority"},
        "caveats": {"$ref": "#/$defs/caveats"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
